<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for nostyra-runner (macOS Developer ID builds, see
  scripts/release-macos.sh). The launcher itself needs none.
  - disable-library-validation: libretro cores are third-party .dylib files downloaded
    from the libretro buildbot at run time, not signed by our team.
  - allow-jit / allow-unsigned-executable-memory: JIT cores (Dolphin, PPSSPP, Flycast,
    Mupen64Plus-Next, PCSX ReARMed dynarec, PCSX2) generate machine code at run time.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
