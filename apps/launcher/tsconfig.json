{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@nostyra/backend": ["./src/backend/tauri/index.ts"] }
  },
  "include": ["src", "vite.config.ts", "web-vite-plugin.d.mts", "web-headers.d.mts"],
  "exclude": ["src/**/*.test.ts"]
}
