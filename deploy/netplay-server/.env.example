# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
# Generate secrets with:  openssl rand -base64 48

# HMAC key for room tokens (required, at least 32 bytes).
NETPLAY_SERVER_SECRET=
# Shared with coturn's static-auth-secret (required, at least 16 bytes).
TURN_SECRET=

# Host name in the STUN / TURN urls handed to clients.
TURN_HOST=netplay.nostyra.com
# Public host name (coturn realm, nginx server_name).
PUBLIC_HOST=netplay.nostyra.com

# Socket peers allowed to set X-Real-IP: loopback + docker bridge (nginx on the host
# reaches the container through the bridge gateway).
TRUSTED_PROXY_CIDR=127.0.0.1/32,172.16.0.0/12

# Optional caps (defaults shown).
# MAX_ROOMS=500
# MAX_SPECTATORS=8

# Required: IP(s) coturn listens and relays on = the public address on the VPS
# interface (`ip addr`); IPv4, optionally `,<IPv6>`. Without it coturn also uses the
# docker bridge IPs and remote players can get an unreachable relay address.
TURN_RELAY_IP=203.0.113.10
# TURN_RELAY_IP=203.0.113.10,2001:db8::1

# Optional: only when the VPS is behind 1:1 NAT (public IP not shown by `ip addr`).
# TURN_EXTERNAL_IP=203.0.113.10

# Log level (tracing env filter).
RUST_LOG=info
