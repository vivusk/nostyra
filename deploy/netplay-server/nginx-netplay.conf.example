# nginx vhost for the Nostyra netplay server (M20). The VPS's nginx already serves other
# sites on 80/443: this adds one more server block, it does not add a listener.
#
#   # 1. certificate first (DNS netplay.nostyra.com -> VPS; certbot serves the challenge
#   #    through the running nginx), so `nginx -t` finds the files named below:
#   sudo certbot certonly --nginx -d netplay.nostyra.com
#   # 2. the vhost:
#   sudo cp nginx-netplay.conf.example /etc/nginx/sites-available/netplay.nostyra.com
#   sudo ln -s /etc/nginx/sites-available/netplay.nostyra.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Renewal runs through certbot's existing timer (`certbot renew`, nginx authenticator).
#
# The server itself listens on 127.0.0.1:3536 (docker-compose publishes loopback only).

# WebSocket upgrade only when the client asks for it.
map $http_upgrade $netplay_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name netplay.nostyra.com;
    # certbot's HTTP-01 challenge keeps working; everything else goes to https.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name netplay.nostyra.com;

    # Files from `certbot certonly --nginx -d netplay.nostyra.com`.
    ssl_certificate     /etc/letsencrypt/live/netplay.nostyra.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/netplay.nostyra.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 8k;

    # REST API + health. Request URIs carry room codes: keep them out of the access log.
    location / {
        access_log off;
        proxy_pass http://127.0.0.1:3536;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The server trusts this header only from 127.0.0.1 / docker bridge peers
        # (TRUSTED_PROXY_CIDR) and keys its rate limits on it.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # Signaling WebSocket. The URI carries the room token (`?token=`): never log it.
    location /v1/ws/ {
        access_log off;
        proxy_pass http://127.0.0.1:3536;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $netplay_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        # Idle signaling sockets stay open through a whole session (default 60 s would
        # cut them; matchbox also sends a keep-alive every 10 s).
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
